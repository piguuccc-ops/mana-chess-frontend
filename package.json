{
  "name": "mana-chess-frontend",
  "version": "1.1.1",
  "private": true,
  "license": "MIT",
  "author": "piguuccc-ops",
  "description": "Mana Chess – chess with a Clash Royale-style mana and spell system: the game and the server that hands it out",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-single.mjs && node scripts/build-server.mjs",
    "start": "node dist/frontend.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:spells": "tsx scripts/gen-spells-doc.ts",
    "balance": "tsx scripts/balance.ts",
    "android": "bash android/build.sh",
    "android:icons": "tsx android/scripts/make-icons.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}

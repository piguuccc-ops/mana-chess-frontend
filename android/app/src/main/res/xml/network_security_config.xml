<?xml version="1.0" encoding="utf-8"?>
<!-- A backend on the home network has no certificate: plain http is allowed (https as usual). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
